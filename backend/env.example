# Database
# Pour Supabase, utilisez le TRANSACTION POOLER (recommandé pour Prisma)
# Port: 6543 (Transaction pooler) au lieu de 5432 (Direct connection)
# Format: postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
# 
# Pour trouver votre connection string:
# 1. Supabase Dashboard > Settings > Database
# 2. Section "Connection string" > Sélectionnez "Transaction pooler"
# 3. Copiez la connection string et remplacez [YOUR-PASSWORD] par votre mot de passe
#
# Exemple:
# DATABASE_URL="postgresql://postgres.xxxxx:VotreMotDePasse@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="1d"

# Server Configuration
NODE_ENV="development"
BACKEND_PORT=3001
FRONTEND_URL="http://localhost:3000"

# CORS (optionnel, par défaut utilise FRONTEND_URL)
# CORS_ORIGIN="http://localhost:3000,https://yourdomain.com"

